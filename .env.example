# Defaults match docker-compose.yml, so a .env file is optional in development.
DATABASE_URL=postgres://pass:pass@localhost:5433/pass
TEST_DATABASE_URL=postgres://pass:pass@localhost:5433/pass_test
REDIS_URL=redis://localhost:6380

API_PORT=4000
GATEWAY_PORT=4100
WEB_PORT=3000

# Hard cap on WebSocket connections per gateway instance (NFR-3).
MAX_CONNECTIONS=10000

# Maps (FR-20). Without these, maps use MapLibre and routes are straight lines.
# Browser key: restrict it to your domain and cap its daily quota (NFR-20).
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
# Server key for Google's Routes API.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_ROUTES_MODE=DRIVE
